{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push -uf*)",
      "Bash(git push -fu*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * -uf*)",
      "Bash(git push * -fu*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean*)",
      "Bash(git stash*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -r -f*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update)",
      "Bash(npm update *)",
      "Bash(npm run test:ui*)",
      "Bash(npx playwright *)",
      "Bash(npm run perf*)",
      "Bash(gh pr *)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --contains *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:types)",
      "Bash(npm run lint:architecture)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test)",
      "Bash(npm run test -- *)",
      "Bash(npx vitest run *)",
      "Bash(npm run build)",
      "Bash(npm run verify)"
    ]
  }
}
